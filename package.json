{
  "name": "@ayhammouda/gsc-seo-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing Google Search Console SEO data.",
  "type": "module",
  "bin": {
    "gsc-seo-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs",
    "server.json",
    "glama.json",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.7.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --exclude \"tests/e2e/**\" --exclude \"tests/live/**\"",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "test:live": "npm run build && vitest run tests/live",
    "pack:dry-run": "npm pack --dry-run --json",
    "mcpb:validate": "mcpb validate mcpb/manifest.json",
    "mcpb:pack": "npm run build && node scripts/build-mcpb.mjs",
    "mcpb:smoke": "node scripts/smoke-mcpb.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "googleapis": "173.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "gaxios": "7.1.5",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
